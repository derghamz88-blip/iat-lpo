{
 "name": "IAT LPO",
 "short_name": "IAT LPO",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#EEF3F4",
 "theme_color": "#13303A",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any maskable"
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "url": "url",
   "files": [
    {
     "name": "lpo",
     "accept": [
      "application/pdf",
      "image/jpeg",
      "image/png",
      "image/*",
      "*/*"
     ]
    }
   ]
  }
 },
 "id": "./?app=iat-lpo"
}